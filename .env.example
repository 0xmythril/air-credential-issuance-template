# =============================================
# AIR KIT CONFIGURATION
# =============================================

# Generate ECDSA private key (P-256 curve):
# 1. openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | tr -d '\n'
# 2. Copy the middle part (between BEGIN and END lines) and paste it below
# Example: PARTNER_PRIVATE_KEY="MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg..."
PARTNER_PRIVATE_KEY=""

# JWT signing algorithm (ES256, RS256, etc.)
SIGNING_ALGORITHM="ES256"

# =============================================
# BUILD & CHAIN CONFIGURATION
# =============================================

# Environment: production, sandbox, staging
NEXT_PUBLIC_BUILD_ENV=sandbox

# Moca chain: mainnet, devnet
NEXT_PUBLIC_MOCA_CHAIN=devnet

# =============================================
# AIR KIT CREDENTIALS
# =============================================

# Get these from your AIR Kit dashboard
NEXT_PUBLIC_PARTNER_ID=""
NEXT_PUBLIC_ISSUER_DID=""

# =============================================
# ROUTE-SPECIFIC ISSUANCE PROGRAMS (Required)
# =============================================

# Each route MUST have its own issuance program ID configured
# Set the program ID for each route you plan to use

# Spotify route program (/spotify → uses this program)
NEXT_PUBLIC_SPOTIFY_PROGRAM_ID=""

# Twitter route program (/twitter → uses this program)
NEXT_PUBLIC_TWITTER_PROGRAM_ID=""

# Discord route program (/discord → uses this program)
NEXT_PUBLIC_DISCORD_PROGRAM_ID=""

# Ethos/Wallet route program (/ethos or /wallet → uses this program)
# You can use either ETHOS or WALLET, they both map to the same route
NEXT_PUBLIC_ETHOS_PROGRAM_ID=""
NEXT_PUBLIC_WALLET_PROGRAM_ID=""

# AIR Kit route program (/airkit → uses this program)
NEXT_PUBLIC_AIRKIT_PROGRAM_ID=""

# =============================================
# DEPRECATED (Optional - No longer used)
# =============================================

# This variable is deprecated and no longer used
# Each route now requires its own specific program ID above
# You can remove this from your .env file
NEXT_PUBLIC_ISSUE_PROGRAM_ID=""

# =============================================
# WALLET CONNECT CONFIGURATION
# =============================================

# Get from https://cloud.walletconnect.com/
NEXT_PUBLIC_REOWN_PROJECT_ID=""

# =============================================
# APPLICATION CONFIGURATION
# =============================================

# Optional: Custom headline (if not set, will be auto-generated based on route/auth method)
NEXT_PUBLIC_HEADLINE=""
NEXT_PUBLIC_APP_NAME="AIR Issuance"
NEXT_PUBLIC_THEME=system

# =============================================
# SPOTIFY OAUTH (Optional - only if using Spotify auth)
# =============================================

# Get from https://developer.spotify.com/dashboard
# Both values should be the SAME - your Spotify app's client ID
SPOTIFY_CLIENT_ID=""                    # Server-side OAuth
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=""        # Client-side API calls
SPOTIFY_CLIENT_SECRET=""                # Server-side OAuth secret

# =============================================
# TWITTER OAUTH (Optional - only if using Twitter auth)
# =============================================

# Get from https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# =============================================
# DISCORD OAUTH (Optional - only if using Discord auth)
# =============================================

# Get from https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# =============================================
# DEVELOPMENT & TESTING
# =============================================

# Test wallet address for development
NEXT_PRIVATE_TEST_ADDRESS=""

# Nansen API key for blockchain data (optional)
NEXT_PRIVATE_NANSEN_API_KEY=""

# =============================================
# ANNOUNCEMENT BANNER (Optional)
# =============================================

# This displays a banner at the top of the page with a title, message, and a dismiss button.
# The banner is displayed for the number of days specified in NEXT_PUBLIC_ANNOUNCEMENT_TTL_DAYS.
# The banner is dismissed by the user by clicking the dismiss button.
# The banner is displayed again after the number of days specified in NEXT_PUBLIC_ANNOUNCEMENT_TTL_DAYS.
NEXT_PUBLIC_ANNOUNCEMENT_TITLE="Alpha Release"
NEXT_PUBLIC_ANNOUNCEMENT_MESSAGE="Features are experimental and may change."
NEXT_PUBLIC_ANNOUNCEMENT_ID="alpha-v2"
NEXT_PUBLIC_ANNOUNCEMENT_TTL_DAYS=14

# =============================================
# ROUTE HERO IMAGES (Optional)
# =============================================

# These display a hero image between the header and issuance UI per route.
# Use a public URL or a path under /public (e.g., "/twitter-hero.jpg").
# Leave blank to hide for that route.
NEXT_PUBLIC_TWITTER_HERO=""
NEXT_PUBLIC_SPOTIFY_HERO=""
NEXT_PUBLIC_DISCORD_HERO=""
NEXT_PUBLIC_ETHOS_HERO=""
NEXT_PUBLIC_AIRKIT_HERO=""